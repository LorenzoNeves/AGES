// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============ DIMENSÕES ============

model DimCliente {
  id_cliente            Int       @id @default(autoincrement())
  nome                  String    @db.VarChar(150)
  email                 String   @db.VarChar(100)
  senha                 String?   @db.VarChar(255)
  telefone              String?   @db.VarChar(20)
  cpf                   String?   @unique @db.VarChar(14)
  data_nascimento       DateTime?
  
  rua                   String?   @db.VarChar(150)
  numero                String?   @db.VarChar(10)
  bairro                String?   @db.VarChar(100)
  cidade                String?   @db.VarChar(50)
  estado                String?   @db.VarChar(2)
  cep                   String?   @db.VarChar(10)
  
  ativo                 Boolean   @default(true)
  data_cadastro         DateTime  @default(now())
  data_atualizacao      DateTime  @updatedAt
  
  vendas                FactVenda[]
  devolucoes            FactDevolucao[]
  
  @@map("dim_cliente")
}

model DimMedicamento {
  id_medicamento        Int       @id @default(autoincrement())
  
  nome_comercial        String    @db.VarChar(150)
  nome_generico         String?   @db.VarChar(150)
  principio_ativo       String    @db.VarChar(150)
  
  categoria             String?   @db.VarChar(50)
  tipo_medicamento      String?   @db.VarChar(50)
  
  dosagem               String?   @db.VarChar(50)
  quantidade_embalagem  Int?
  unidade_medida        String?   @db.VarChar(20)
  
  preco_custo           Decimal   @db.Decimal(10, 2)
  preco_venda           Decimal   @db.Decimal(10, 2)
  
  id_fornecedor         Int?
  fornecedor            DimFornecedor? @relation(fields: [id_fornecedor], references: [id_fornecedor])
  
  requer_prescricao     Boolean   @default(false)
  controlado            Boolean   @default(false)
  lote                  String?   @db.VarChar(50)
  data_validade         DateTime?
  
  ativo                 Boolean   @default(true)
  data_cadastro         DateTime  @default(now())
  data_atualizacao      DateTime  @updatedAt
  
  vendas                FactVenda[]
  estoques              FactEstoque[]
  devolucoes            FactDevolucao[]
  
  @@map("dim_medicamento")
}

model DimFornecedor {
  id_fornecedor         Int       @id @default(autoincrement())
  
  nome_fornecedor       String    @db.VarChar(150)
  cnpj                  String?   @unique @db.VarChar(18)
  email                 String   @db.VarChar(100)
  telefone              String?   @db.VarChar(20)
  
  rua                   String?   @db.VarChar(150)
  cidade                String?   @db.VarChar(50)
  estado                String?   @db.VarChar(2)
  cep                   String?   @db.VarChar(10)
  
  pessoa_contato        String?   @db.VarChar(100)
  telefone_contato      String?   @db.VarChar(20)
  
  dias_pagamento        Int?
  condicao_pagamento    String?   @db.VarChar(50)
  
  ativo                 Boolean   @default(true)
  data_cadastro         DateTime  @default(now())
  
  medicamentos          DimMedicamento[]
  
  @@map("dim_fornecedor")
}

model DimData {
  id_data               Int       @id
  data_completa         DateTime  @unique
  
  dia                   Int
  mes                   Int
  ano                   Int
  trimestre             Int
  semana                Int
  dia_semana            String    @db.VarChar(15)
  mes_nome              String    @db.VarChar(15)
  
  eh_feriado            Boolean   @default(false)
  eh_fim_semana         Boolean   @default(false)
  eh_dia_util           Boolean   @default(true)
  
  vendas                FactVenda[]
  
  @@map("dim_data")
}

model DimFarmacia {
  id_farmacia           Int       @id @default(autoincrement())
  
  nome_farmacia         String    @db.VarChar(150)
  cnpj                  String?   @db.VarChar(18)
  endereco              String?   @db.VarChar(200)
  cidade                String?   @db.VarChar(50)
  estado                String?   @db.VarChar(2)
  
  telefone              String?   @db.VarChar(20)
  email                 String   @db.VarChar(100)
  
  gerente_nome          String?   @db.VarChar(100)
  gerente_telefone      String?   @db.VarChar(20)
  
  ativo                 Boolean   @default(true)
  data_inauguracao      DateTime?
  
  vendedores            DimVendedor[]
  vendas                FactVenda[]
  estoques              FactEstoque[]
  
  @@map("dim_farmacia")
}

model DimVendedor {
  id_vendedor           Int       @id @default(autoincrement())
  
  nome_vendedor         String    @db.VarChar(100)
  cpf                   String?   @unique @db.VarChar(14)
  email                 String   @db.VarChar(100)
  telefone              String?   @db.VarChar(20)
  
  cargo                 String?   @db.VarChar(50)
  id_farmacia           Int
  farmacia              DimFarmacia @relation(fields: [id_farmacia], references: [id_farmacia])
  
  data_admissao         DateTime
  contato_emergencia    String?   @db.VarChar(100)
  telefone_emergencia   String?   @db.VarChar(20)
  
  ativo                 Boolean   @default(true)
  
  vendas                FactVenda[]
  
  @@map("dim_vendedor")
}

// ============ FATOS ============

model FactVenda {
  id_venda              Int       @id @default(autoincrement())
  
  id_cliente            Int
  cliente               DimCliente @relation(fields: [id_cliente], references: [id_cliente])
  
  id_medicamento        Int
  medicamento           DimMedicamento @relation(fields: [id_medicamento], references: [id_medicamento])
  
  id_vendedor           Int
  vendedor              DimVendedor @relation(fields: [id_vendedor], references: [id_vendedor])
  
  id_data               Int
  data                  DimData @relation(fields: [id_data], references: [id_data])
  
  id_farmacia           Int
  farmacia              DimFarmacia @relation(fields: [id_farmacia], references: [id_farmacia])
  
  quantidade            Int
  preco_unitario        Decimal   @db.Decimal(10, 2)
  valor_total           Decimal   @db.Decimal(12, 2)
  desconto_pct          Decimal   @default(0) @db.Decimal(5, 2)
  valor_com_desconto    Decimal   @db.Decimal(12, 2)
  
  numero_nfe            String?   @db.VarChar(50)
  numero_receita        String?   @db.VarChar(50)
  tipo_pagamento        String?   @db.VarChar(20)
  
  status_venda          String    @default("Concluída") @db.VarChar(20)
  
  data_venda            DateTime  @default(now())
  data_atualizacao      DateTime  @updatedAt
  observacoes           String?   @db.VarChar(500)
  
  devolucoes            FactDevolucao[]
  
  @@index([id_cliente])
  @@index([id_medicamento])
  @@index([id_data])
  @@index([id_farmacia])
  @@map("fact_vendas")
}

model FactEstoque {
  id_estoque            Int       @id @default(autoincrement())
  
  id_medicamento        Int
  medicamento           DimMedicamento @relation(fields: [id_medicamento], references: [id_medicamento])
  
  id_farmacia           Int
  farmacia              DimFarmacia @relation(fields: [id_farmacia], references: [id_farmacia])
  
  quantidade_atual      Int
  quantidade_minima     Int
  quantidade_maxima     Int
  
  lote_atual            String?   @db.VarChar(50)
  data_validade_lote    DateTime?
  
  data_ultima_reposicao DateTime?
  data_atualizacao      DateTime  @updatedAt
  
  @@unique([id_medicamento, id_farmacia])
  @@map("fact_estoque")
}

model FactDevolucao {
  id_devolucao          Int       @id @default(autoincrement())
  
  id_venda              Int
  venda                 FactVenda @relation(fields: [id_venda], references: [id_venda])
  
  id_cliente            Int
  cliente               DimCliente @relation(fields: [id_cliente], references: [id_cliente])
  
  id_medicamento        Int
  medicamento           DimMedicamento @relation(fields: [id_medicamento], references: [id_medicamento])
  
  quantidade_devolvida  Int
  motivo_devolucao      String?   @db.VarChar(100)
  valor_reembolso       Decimal   @db.Decimal(12, 2)
  
  data_devolucao        DateTime  @default(now())
  
  @@map("fact_devolucoes")
}